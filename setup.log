# https://docs.nginx.com/nginx/admin-guide/basic-functionality/runtime-control/
# nginx -s reload
server {
  listen 80;
  listen [::]:80; # for iv6
  server_name hk-hphi.com;
  return 301 http://www.hk-hphi.com$request_uri;
}

server {
  listen 80;
  listen [::]:80; # for iv6
  server_name www.hk-hphi.com;
  server_tokens off;
  client_max_body_size 30M;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen        443       ssl;
  listen        [::]:443  ssl;
  server_name   hk-hphi.com;

  ssl_certificate /etc/letsencrypt/live/hk-hphi.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/hk-hphi.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  return 301 https://www.hk-hphi.com$request_uri;
}

server {
  listen        443       ssl;
  listen        [::]:443  ssl;
  server_name   www.hk-hphi.com;
  server_tokens off;
  client_max_body_size 30M;

  ssl_certificate /etc/letsencrypt/live/hk-hphi.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/hk-hphi.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  # error_log  /var/log/nginx/hk-hphi.com-error.log;
  # access_log /var/log/nginx/hk-hphi.com-access.log;

  location /_next/static {
    add_header Cache-Control "public, max-age=3600, immutable";
    proxy_pass http://localhost:4002/_next/static;
  }

  location / {
    # reverse proxy for next server
    proxy_pass              http://localhost:4002/;
    proxy_read_timeout      60;
    proxy_connect_timeout   60;
    proxy_redirect          off;

    # Allow the use of websockets
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;

    proxy_set_header    X-Real-IP $remote_addr;
    proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
    # proxy_set_header    X-Forwarded-Host   $http_host;
    # proxy_cookie_path   /                  "/; Secure";

    # we need to remove this 404 handling
    # because next's _next folder and own handling
    # try_files $uri $uri/ =404;
  }
}


